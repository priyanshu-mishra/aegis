---
import Base from "../layouts/Base.astro";
import RedHerring from "../components/RedHerring.astro";
import RunningHead from "../components/RunningHead.astro";
import ProgressBar from "../components/ProgressBar.astro";
import Exhibit from "../components/Exhibit.astro";
import IntervalChart from "../components/IntervalChart.astro";
import Why from "../chapters/Why.astro";
import Portfolio from "../chapters/Portfolio.astro";
import Forecast from "../chapters/Forecast.astro";
import Intervals from "../chapters/Intervals.astro";
import Adapt from "../chapters/Adapt.astro";
import Tails from "../chapters/Tails.astro";
import Regulator from "../chapters/Regulator.astro";
import Sizing from "../chapters/Sizing.astro";
import Text from "../chapters/Text.astro";
import RiskFactors from "../chapters/RiskFactors.astro";
import Checks from "../chapters/Checks.astro";
import { chapters } from "../lib/chapters";
import { annual, formatDate, load, pct, slice, type Frame } from "../lib/data";
import { testCounts } from "../lib/repo";

const meta = load("meta");
const metrics = load("metrics");
const status = load("status");
const vol = load<Frame>("vol");

const vm = metrics.vol;
const v99 = metrics.var["0.01"];
const firstYear = meta.splits.test.start.slice(0, 4);
const lastYear = meta.splits.test.end.slice(0, 4);
const testDays = meta.splits.test.rows;
const level = 1 - meta.alpha; // 0.95

// Exhibit A: the first test year, and its month-by-month coverage (the table view).
const y2020 = slice(vol, "2020-01-01", "2020-12-31");
const inside = (f: Frame, m: string, i: number) => {
  const y = f.series.y[i], lo = f.series[`${m}_lo`][i], hi = f.series[`${m}_hi`][i];
  return y != null && lo != null && hi != null && y >= lo && y <= hi;
};
const months = [...new Set(y2020.dates.map((d) => d.slice(0, 7)))].map((ym) => {
  const idx = y2020.dates.map((d, i) => (d.startsWith(ym) ? i : -1)).filter((i) => i >= 0);
  const cov = (m: string) => idx.filter((i) => inside(y2020, m, i)).length / idx.length;
  return { ym, days: idx.length, aci: cov("aci"), split: cov("split_absolute") };
});
const monthName = (ym: string) =>
  new Date(ym + "-01T00:00:00Z").toLocaleDateString("en-GB", { month: "long", timeZone: "UTC" });

const tests = testCounts();
const rmBreach = v99.gaussian_var.breach_rate;
const aciBreach = v99.aci_var.breach_rate;
const wild = Math.max(...y2020.series.y.map((x) => annual(x) ?? 0));

const findings = [
  {
    what: `Share of days the ${pct(level, 0)} interval held, ${firstYear}–${lastYear}`,
    result: pct(vm.aci.coverage),
    target: pct(level, 0),
    note: `textbook method: ${pct(vm.split_absolute.coverage)}`,
  },
  {
    what: `The same, in ${firstYear} alone`,
    result: pct(vm.aci.by_year[firstYear]),
    target: pct(level, 0),
    note: `textbook method: ${pct(vm.split_absolute.by_year[firstYear])}`,
  },
  {
    what: "Days a 99% loss limit was breached",
    result: pct(aciBreach, 2),
    target: "1.00%",
    note: `normal-distribution model: ${pct(rmBreach, 2)}`,
  },
];
const exhibitALabel = `Line chart of realized volatility in ${firstYear} with a shaded forecast range; the range widens in March as volatility jumps to ${wild.toFixed(0)}%.`;
const asOf = formatDate(status.data_last_day ?? meta.data.last_day);
---
<Base
  title="Aegis: honest error bars for portfolio risk"
  description="A walk-forward study of conformal prediction for portfolio risk, 2020–2026, by Priyanshu Mishra."
>
  <RedHerring asOf={asOf} fresh={status.fresh !== false} />
  <ProgressBar />
  <RunningHead chapters={chapters} />

  <main>
    <section class="cover" id="cover" aria-labelledby="title">
      <div class="cover-col">
        <h1 id="title">
          <span class="mark">Aegis</span>
          <span class="sub">Honest error bars for portfolio risk</span>
        </h1>
        <p class="study">A walk-forward study, {firstYear}–{lastYear}</p>
        <p class="lede">
          I built a model that forecasts how much a portfolio could lose, attaches a range it promises
          to be right about {pct(level, 0)} of the time, and then checked that promise on {testDays.toLocaleString("en-GB")}
          trading days the model never saw.
        </p>

        <table class="findings">
          <caption class="visually-hidden">Summary of findings: result against target</caption>
          <thead>
            <tr>
              <th scope="col">Finding</th>
              <th scope="col" class="num">Result</th>
              <th scope="col" class="num">Target</th>
            </tr>
          </thead>
          <tbody>
            {
              findings.map((f) => (
                <tr>
                  <th scope="row">
                    {f.what}
                    <span class="cmp">{f.note}</span>
                  </th>
                  <td class="num result">{f.result}</td>
                  <td class="num">{f.target}</td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <dl class="about">
          <div>
            <dt>The problem</dt>
            <dd>
              Funds, trading desks and banks size positions, set loss limits and hold capital against a
              risk forecast. A forecast is one number; what decides whether it can be trusted is how
              wrong it might be. Over {firstYear}–{lastYear} the industry-standard model broke its 99%
              loss limit on {pct(rmBreach, 2)} of days, against the 1% it promised.
            </dd>
          </div>
          <div>
            <dt>What I built</dt>
            <dd>
              An end-to-end market-risk system for a four-fund portfolio: volatility and Value-at-Risk
              forecasts, adaptive error bars around them, nine VaR methods compared head to head (four
              conformal, five classical), regulatory-style backtests, and position-sizing rules that act
              on the forecasts. It rebuilds and redeploys itself every weeknight from fresh market data.
            </dd>
          </div>
          <div>
            <dt>What it shows</dt>
            <dd>
              A statistical method chosen for its guarantee; an evaluation built so it cannot flatter the
              method ({tests.leakage} of {tests.all} test functions guard against look-ahead); and plain reporting of
              where it lost, including bugs I found in my own pipeline (<a href="#risk-factors">chapter 10</a>).
            </dd>
          </div>
          <div>
            <dt>Where to start</dt>
            <dd>
              <a href="#why">Chapter 1</a> makes the case for why this matters; <a href="#checks">chapter 11</a>
              shows how it was checked. For model-risk readers, the same evidence is written up as a
              <a href="https://github.com/priyanshu-mishra/aegis/blob/main/docs/MODEL_CARD.md">validation report</a>.
            </dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>Python, scikit-learn, conformal prediction, a local language model, Astro and Svelte, GitHub Actions.</dd>
          </div>
        </dl>

        <p class="byline">
          Priyanshu Mishra ·
          <a href="https://github.com/priyanshu-mishra">GitHub</a> ·
          <a href="https://www.linkedin.com/in/priyanshu-mishra-/">LinkedIn</a> ·
          <a href="https://github.com/priyanshu-mishra/aegis">Source code</a>
        </p>
      </div>

      <div class="cover-exhibit">
        <Exhibit
          letter="A"
          title={`${firstYear}: the range held through the crash`}
          source={`Realized 5-day volatility of the four-asset portfolio (line), annualized, against the adaptive conformal ${pct(level, 0)} range (shaded) and the textbook range (dashed). Circles mark days the realized value fell outside the shaded range. Daily data, log scale.`}
          id="exhibit-a"
        >
          <IntervalChart frame={y2020} label={exhibitALabel} />
          <IntervalChart frame={y2020} label={exhibitALabel} narrow />
          <table slot="table">
            <thead>
              <tr>
                <th scope="col">Month</th>
                <th scope="col">Days</th>
                <th scope="col">Adaptive held</th>
                <th scope="col">Textbook held</th>
              </tr>
            </thead>
            <tbody>
              {
                months.map((m) => (
                  <tr>
                    <td>{monthName(m.ym)}</td>
                    <td>{m.days}</td>
                    <td>{pct(m.aci, 0)}</td>
                    <td>{pct(m.split, 0)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </Exhibit>
      </div>
    </section>

    <Why />
    <Portfolio />
    <Forecast />
    <Intervals />
    <Adapt />
    <Tails />
    <Regulator />
    <Sizing />
    <Text />
    <RiskFactors />
    <Checks />

  </main>
</Base>

<style>
  main {
    padding-left: var(--herring-margin);
  }

  /* Cover: the offering summary left, Exhibit A right. */
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
    gap: var(--s4);
    align-items: start;
    max-width: 82rem;
    margin: 0 auto;
    padding: var(--s4) var(--s3) var(--s5);
  }
  h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--s1);
  }
  .mark {
    font-size: var(--step-4);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    margin-right: -0.32em; /* the tracking after the last letter would push it off centre */
    line-height: 1;
    font-variation-settings: "opsz" 60;
  }
  .sub {
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
  }
  .study {
    margin: var(--s1) 0 0;
    text-align: center;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }
  .lede {
    margin: var(--s2) 0 0;
    padding-bottom: var(--s2);
    border-bottom: 3px double var(--rule-strong);
    text-align: center;
    color: var(--ink-2);
  }

  .findings {
    width: 100%;
    margin-top: var(--s2);
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.4;
  }
  .findings thead th {
    font-weight: 600;
    font-size: var(--step--1);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    text-align: left;
    border-bottom: 1px solid var(--rule-strong);
    padding: 0 0 var(--s-1);
  }
  .findings tbody th,
  .findings td {
    padding: var(--s0) 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .findings tbody th {
    font-weight: 400;
    text-align: left;
    padding-right: var(--s1);
  }
  .cmp {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .num {
    text-align: right;
    white-space: nowrap;
  }
  .findings thead .num {
    text-align: right;
  }
  .findings td.num + td.num {
    padding-left: var(--s1);
    color: var(--ink-3);
  }
  .result {
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .about {
    margin: var(--s2) 0 0;
    border-top: 1px solid var(--rule-strong);
  }
  .about > div {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr);
    column-gap: var(--s1);
    padding: var(--s0) 0;
    border-bottom: 1px solid var(--rule);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .about dt {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--ink);
  }
  .about dd {
    margin: 0;
  }
  .byline {
    margin: var(--s3) 0 0;
    padding-top: var(--s0);
    border-top: 1px solid var(--rule-strong);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .cover-exhibit {
    position: sticky;
    top: calc(var(--head-h) + var(--s2));
    padding-top: calc(var(--step-4) + var(--s2));
  }

  @media (max-width: 960px) {
    main {
      padding-left: 0;
    }
    .cover {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s3);
      padding: var(--s3) var(--s1) var(--s4);
    }
    .cover-exhibit {
      position: static;
      padding-top: 0;
    }
  }
  @media (max-width: 600px) {
    .about > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
