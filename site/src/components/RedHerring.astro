---
// The red-herring legend: a preliminary prospectus prints this in red down the cover margin.
// Here it states, truthfully, that the figures are preliminary and refresh from market data.
interface Props {
  asOf: string;
  fresh: boolean;
}
const { asOf, fresh } = Astro.props;
---
<aside class="herring" aria-label="Status of these figures">
  <p>
    Preliminary · the figures in this study refresh every weeknight from market data and may change ·
    data through {asOf}{fresh ? "" : " · the latest refresh failed, so these are the last good figures"}
    · nothing here is investment advice
  </p>
</aside>

<style>
  .herring {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--herring-margin);
    border-right: 1.5px solid var(--herring);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    background: var(--paper);
  }
  .herring p {
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--herring);
    font-size: var(--step--1);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    line-height: 1.3;
    max-height: 92vh;
    text-align: center;
  }
  @media (max-width: 960px) {
    .herring {
      position: static;
      width: auto;
      border-right: 0;
      border-bottom: 1.5px solid var(--herring);
      padding: var(--s0) var(--s1);
    }
    .herring p {
      writing-mode: horizontal-tb;
      transform: none;
      max-height: none;
    }
  }
</style>
