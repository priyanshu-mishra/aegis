---
// A hairline across the very top of the page that fills as the reader moves through the note.
---
<div class="progress" aria-hidden="true"><div class="fill"></div></div>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 5;
    pointer-events: none;
  }
  .fill {
    height: 100%;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media print {
    .progress {
      display: none;
    }
  }
</style>

<script>
  const fill = document.querySelector<HTMLElement>(".progress .fill");
  let queued = false;
  const update = () => {
    queued = false;
    const room = document.documentElement.scrollHeight - window.innerHeight;
    const p = room > 0 ? Math.min(1, Math.max(0, window.scrollY / room)) : 0;
    if (fill) fill.style.transform = `scaleX(${p})`;
  };
  const schedule = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener("scroll", schedule, { passive: true });
  addEventListener("resize", schedule);
  update();
</script>
