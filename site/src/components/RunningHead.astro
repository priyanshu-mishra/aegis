---
// A prospectus repeats a running head on every page; here it is the sticky chapter rail.
interface Chapter {
  n: string;
  id: string;
  title: string;
  short: string;
  ready: boolean;
}
interface Props {
  chapters: Chapter[];
}
const { chapters } = Astro.props;
const ready = chapters.filter((c) => c.ready);
const pending = chapters.filter((c) => !c.ready);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<header class="head">
  <a class="mark" href={`${base}/#cover`}>Aegis</a>
  <nav aria-label="Chapters">
    <ol>
      {
        ready.map((c) => (
          <li>
            <a href={`#${c.id}`} title={c.title}>
              <span class="n">{c.n}</span>
              {c.short}
            </a>
          </li>
        ))
      }
      {pending.length > 0 && (
        <li class="pending">
          <a href="#contents">
            <span class="n">{pending[0].n}–{pending[pending.length - 1].n}</span>
            in preparation
          </a>
        </li>
      )}
    </ol>
  </nav>
  <div class="tools">
    <button class="theme" type="button" hidden aria-pressed="false">Dark</button>
    <a class="out" href="https://github.com/priyanshu-mishra/aegis">Code</a>
  </div>
</header>

<style>
  .head {
    position: sticky;
    top: 0;
    z-index: 3;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s2);
    height: var(--head-h);
    padding: 0 var(--s3) 0 calc(var(--herring-margin) + var(--s3));
    background: var(--paper);
    border-bottom: 1px solid var(--rule-strong);
    font-size: var(--step--1);
  }
  .mark {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.24em;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
  }
  nav {
    overflow-x: auto;
    scrollbar-width: none;
  }
  /* When the list is wider than the head, fade its right edge so it reads as scrollable. */
  @media (max-width: 1100px) {
    nav {
      mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
      padding-right: 2rem;
    }
  }
  ol {
    display: flex;
    gap: var(--s2);
    list-style: none;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }
  li a {
    display: inline-block;
    padding-block: 0.375rem; /* a 30px tap target inside the head's height */
    text-decoration: none;
    color: var(--ink-2);
  }
  li a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .n {
    margin-right: 0.35em;
    color: var(--ink-3);
  }
  .pending a {
    color: var(--ink-3);
  }
  .out {
    color: var(--ink-2);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--s1);
  }
  .theme {
    font: inherit;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--rule-strong);
    padding: 0.25rem 0.625rem;
    min-height: 1.75rem;
    cursor: pointer;
  }
  .theme:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .theme:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  @media print {
    .theme {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .head {
      padding: 0 var(--s1);
      gap: var(--s1);
    }
  }
</style>

<script>
  // Two states, "Dark" and "Light". With no saved choice the page follows the system until the first click.
  const btn = document.querySelector<HTMLButtonElement>(".theme");
  const root = document.documentElement;
  const dark = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : dark.matches);
  const sync = () => {
    if (!btn) return;
    btn.textContent = isDark() ? "Light" : "Dark";
    btn.setAttribute("aria-pressed", String(isDark()));
    btn.setAttribute("aria-label", isDark() ? "Switch to light mode" : "Switch to dark mode");
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", isDark() ? "#141414" : "#ffffff");
  };
  if (btn) {
    btn.hidden = false;
    btn.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("aegis-theme", next);
      } catch {}
      sync();
    });
    dark.addEventListener("change", sync);
    sync();
  }
</script>
